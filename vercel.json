{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "{static/**,brand.json,src/**,data/seed-lib.mjs,tools/illustrations.mjs}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "regions": [
    "fra1"
  ]
}
